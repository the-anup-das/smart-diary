# Database Configuration
DATABASE_URL="postgresql://diary_user:diary_password@localhost:5432/diary_db?schema=public"
JWT_SECRET=super-secret-diary-key-you-should-change

# Security / Deployment
# Comma-separated list of allowed browser origins (set to your real domain in production)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Public URL of the frontend — used to build password-reset links
APP_URL="http://localhost:3000"
# Set to 'true' to disable the built-in auth rate limiting (e.g. behind an authenticating proxy)
RATE_LIMIT_DISABLED=false
# Set to 'true' ONLY if a trusted reverse proxy appends the real client IP to
# X-Forwarded-For; otherwise the header is client-controlled and ignored.
TRUST_PROXY_HEADERS=false

# Password Reset Email (optional — if SMTP_HOST is unset, reset links are
# printed to the backend logs instead, which works fine for self-hosting)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=notebook@example.com

# LLM Configuration
OPENAI_API_KEY="sk-proj-..."
OPENAI_BASE_URL="https://api.openai.com/v1"

# STT (Speech-to-Text) — OPTIONAL. Voice input is hidden entirely when
# STT_BASE_URL is unset. The docker-compose stack ships a faster-whisper
# container on port 8001; these defaults match it:
STT_BASE_URL="http://localhost:8001/v1"
STT_API_KEY="not-needed"
STT_MODEL="Systran/faster-whisper-base.en"
# Any OpenAI-compatible /v1/audio/transcriptions endpoint also works:
#   LM Studio : http://host.docker.internal:1234/v1   (STT_MODEL=whisper-1)
#   OpenAI    : https://api.openai.com/v1             (STT_MODEL=whisper-1 + real key)

# AI model overrides (optional)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# PWA Controls
# Set to 'true' to disable PWA entirely (even in production)
PWA_DISABLED=false
# Set to 'true' to force enable PWA/Service Worker during local development
LOCAL_FORCE_PWA_ENABLE=false
