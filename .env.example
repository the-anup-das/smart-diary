# ══════════════════════════════════════════════════════════════════════════
#  Notebook — environment configuration (local development)
#  Copy to .env and adjust. The backend loads this file automatically.
#  NAS/Docker deployments use deployment/omv/notebook.env instead.
# ══════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://diary_user:diary_password@localhost:5432/diary_db"

# ── Authentication ─────────────────────────────────────────────────────────
# Signs login sessions AND password-reset tokens. Generate a strong value:
#   openssl rand -hex 32
# Frontend and backend must use the same secret.
JWT_SECRET=super-secret-diary-key-you-should-change

# ── AI (required for reflections, chat, insights) ──────────────────────────
OPENAI_API_KEY="sk-proj-..."
# Any OpenAI-compatible endpoint works — for a fully local setup point this
# at Ollama (http://localhost:11434/v1) and set CHAT_MODEL to a local model.
OPENAI_BASE_URL="https://api.openai.com/v1"
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ── Long-term memory (mem0 + Qdrant vector store) ──────────────────────────
# Defaults match the docker-compose Qdrant service; degrades gracefully if
# Qdrant is unreachable (decisions/chat just lose long-term memory context).
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ── Voice input (OPTIONAL — mic button is hidden when STT_BASE_URL is unset)
# The docker-compose stack ships a faster-whisper container on port 8001;
# these defaults match it. Any OpenAI-compatible /v1/audio/transcriptions
# endpoint also works:
#   LM Studio : http://host.docker.internal:1234/v1   (STT_MODEL=whisper-1)
#   OpenAI    : https://api.openai.com/v1             (STT_MODEL=whisper-1 + real key)
STT_BASE_URL="http://localhost:8001/v1"
STT_API_KEY="not-needed"
STT_MODEL="Systran/faster-whisper-base.en"

# ── Security & deployment ──────────────────────────────────────────────────
# Public URL of the frontend — used to build password-reset links.
APP_URL="http://localhost:3000"
# Comma-separated browser origins allowed to call the API directly.
# (Normal usage goes through the Next.js proxy, so this rarely matters.)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Set to 'true' to disable the built-in auth/AI rate limiting entirely.
RATE_LIMIT_DISABLED=false
# Set to 'true' ONLY if a trusted reverse proxy appends the real client IP to
# X-Forwarded-For; otherwise the header is client-controlled and ignored.
TRUST_PROXY_HEADERS=false

# ── Password-reset email (OPTIONAL) ────────────────────────────────────────
# Without SMTP, reset links are printed to the backend logs instead — which
# works fine for self-hosting (read them with: docker logs notebook-backend).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=notebook@example.com

# ── PWA / offline ──────────────────────────────────────────────────────────
# Set to 'true' to disable the service worker entirely (even in production).
PWA_DISABLED=false
# Set to 'true' to force-enable the service worker during local development.
LOCAL_FORCE_PWA_ENABLE=false

# ── Frontend (usually fine as defaults) ────────────────────────────────────
# Where the Next.js server reaches the FastAPI backend (server-side proxy).
# INTERNAL_BACKEND_URL=http://127.0.0.1:8000
