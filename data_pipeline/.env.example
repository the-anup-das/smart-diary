# Copy to data_pipeline/.env. Keys never go in the repo. The app's root .env is loaded first, so
# GOOGLE_API_KEY and GOOGLE_API_KEY_podcast from there are picked up automatically.

# The endpoint that writes, reviews, edits and labels entries (OpenAI-compatible).
LLM_BASE_URL=https://api.eolarityinnovations.com/v1
LLM_API_KEY=

# One fixed teacher for the whole dataset. Change it only after the golden-set comparison
# (scripts/evaluate.py --dataset golden --label teacher-*) shows a better one.
ANALYZER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Rotate writers per batch by listing several, comma separated. One entry means no rotation.
WRITER_MODELS=Qwen/Qwen3-30B-A3B-Instruct-2507
WRITER_BATCH_SIZE=25
EDITOR_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
REVIEWER_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Any role can live on its own server: ANALYZER_BASE_URL / ANALYZER_API_KEY, WRITER_BASE_URL, ...
# A reviewer in LM Studio, a different model from the writer:
# REVIEWER_BASE_URL=http://127.0.0.1:1234/v1
# REVIEWER_API_KEY=lm-studio
# REVIEWER_MODEL=openai/gpt-oss-20b
# Reasoning is set from here, not in the LM Studio window: gpt-oss gets reasoning_effort=low and local
# thinking models (Gemma 4, Qwen3, Nemotron, GLM, DeepSeek, Magistral) get enable_thinking=false by
# default. <ROLE>_EXTRA is a JSON object of request parameters that overrides those defaults:
# REVIEWER_EXTRA={"reasoning_effort": "medium"}
# ANALYZER_EXTRA={"chat_template_kwargs": {"enable_thinking": true}}

# Judges. Spec: base_url|key|model[|extra_json], several separated by ';'. key is env:NAME or a literal.
# Default order: Bonsai 27B on LLM_BASE_URL (private, a different family from the analyzer), then
# LM Studio, then Google AI Studio as overflow.
BONSAI_MODEL=Ternary-Bonsai-2-27B
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b
# LMSTUDIO_EXTRA={"reasoning_effort": "medium"}     # request parameters for the LM Studio judge; same defaults as above
GEMINI_JUDGE_MODEL=gemini-3.6-flash
# JUDGE_ENDPOINTS=https://api.eolarityinnovations.com/v1|env:LLM_API_KEY|Ternary-Bonsai-2-27B;http://localhost:1234/v1|lm-studio|google/gemma-4-26b-a4b;https://generativelanguage.googleapis.com/v1beta/openai|env:GOOGLE_API_KEY|gemini-3.6-flash|{"reasoning_effort":"low","max_tokens":800}

# How many requests one server may be generating at once, and the pause between starts. A 30B
# model that fills most of a card batches two generations; more makes it shift context and
# everything slows down. --concurrency can stay higher than this: samples queue per host and
# keep working on the others.
MAX_CONCURRENT_PER_HOST=2
HOST_PACING_S=0.5
# HOST_LIMITS=api.example.com=2;api.example.com/Small-Model=6;127.0.0.1:1234=1
# A host/model entry wins over the host's, so each model on a gateway can have its own cap.
# How a host's models share their hardware. "separate": each model has its own backend, so the
# limit counts per model and two models run side by side. "shared": one GPU that cannot hold two
# of them, so the limit counts per host and a call for another model waits for it to drain, which
# makes the server swap between batches instead of during them. Default "mixed": per host, no
# switching rule. "*" sets every host.
# HOST_MODELS=api.example.com=separate;127.0.0.1:1234=shared
REQUEST_TIMEOUT_S=180

# Second judge. Unset, another host from the judge list gives the second opinion. A dedicated one:
# JUDGE2_ENDPOINT=https://api.cerebras.ai/v1|env:CEREBRAS_API_KEY|gpt-oss-120b|{"rpm":5,"max_tokens":800,"reasoning_effort":"medium"}
JUDGE2_SAMPLE_RATE=0.10
JUDGE2_FAIL_SAMPLE_RATE=0.25
JUDGE_THRESHOLD=7
JUDGE_SAFETY_MIN=8

# Generation knobs
SEED=3407
EDGE_CASE_RATE=0.30
PERSONA_PROMPT_RATE=0.15
MAX_JUDGE_RETRY=1
LESSONS_MAX=8
TEST_SPLIT_RATIO=0.10
REQUEST_TIMEOUT_S=120
# Cost per million tokens on LLM_BASE_URL, for the summary only (the private server is free).
LLM_PRICE_IN=0
LLM_PRICE_OUT=0
