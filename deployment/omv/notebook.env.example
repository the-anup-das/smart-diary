# --- Global Settings ---
GITHUB_USER=the-anup-das
VERSION=latest
# EXTERNAL_URL is what your browser uses to talk to the backend (e.g. http://192.168.1.10)
EXTERNAL_URL=http://localhost

# --- AI & Memory ---
OPENAI_API_KEY=sk-proj-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL is optional, used for local LLMs or proxies (e.g. http://ollama:11434/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
JWT_SECRET=generate-a-secure-key-for-auth

# --- Local AI (optional) ---
# Serve the fine-tuned model on the NAS: put the GGUF in /AppData/notebook/models, set the file
# name below, and start it with `docker compose --profile local-ai up -d`. With USE_LOCAL_LLM=true
# every AI feature uses it by default; people can still pick Cloud or Local in Settings.
USE_LOCAL_LLM=false
LOCAL_LLM_GGUF=smart-diary-slm.Q4_K_M.gguf
LOCAL_LLM_MODEL=smart-diary-slm
LOCAL_LLM_BASE_URL=http://llm-server:8080/v1
# When the local model fails or returns unusable output, send the request to CHAT_MODEL instead.
LOCAL_LLM_FALLBACK=true
LOCAL_LLM_TIMEOUT=240
LOCAL_LLM_CTX=8192
LOCAL_LLM_THREADS=4
LOCAL_LLM_PARALLEL=2
# Long-term memory embeddings stay on OpenAI unless this points at a local embedding server.
EMBEDDING_BASE_URL=

# --- Database ---
DB_USER=diary_user
DB_PASSWORD=diary_password
DB_NAME=diary_db
